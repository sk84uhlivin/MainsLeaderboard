<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Runs Over Time</title>
    <link rel="icon" href="{{ url_for('static', filename='images/favicon.ico') }}" type="image/x-icon">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: 0;
            padding: 20px;
            min-height: 100vh;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        }
        
        h1 {
            color: #333;
            margin-bottom: 10px;
        }
        
        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
        }
        
        .back-link:hover {
            text-decoration: underline;
        }
        
        .filter-controls {
            display: flex;
            gap: 15px;
            align-items: center;
            margin: 20px 0;
            flex-wrap: wrap;
            padding: 15px;
            background: #f5f5f5;
            border-radius: 8px;
        }
        
        .filter-controls label {
            font-weight: 600;
            color: #333;
        }
        
        .filter-controls input[type="date"] {
            padding: 8px 12px;
            border: 2px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
        }
        
        .filter-controls button {
            padding: 8px 16px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s;
        }
        
        .filter-controls button:hover {
            transform: translateY(-2px);
        }
        
        .filter-controls button:active {
            transform: translateY(0);
        }
        
        .filter-controls button.reset {
            background: #6c757d;
        }
        
        #chartContainer {
            width: 100%;
            height: 500px;
            margin-top: 20px;
        }
        
        .stats {
            display: flex;
            gap: 20px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 8px;
            flex: 1;
            min-width: 200px;
        }
        
        .stat-label {
            font-size: 14px;
            opacity: 0.9;
        }
        
        .stat-value {
            font-size: 32px;
            font-weight: bold;
            margin-top: 5px;
        }
        
        .chart-hint {
            text-align: center;
            color: #666;
            font-size: 13px;
            margin-top: 10px;
            font-style: italic;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← Back to Leaderboard</a>
        <h1>Runs Over Time</h1>
        
        <div class="filter-controls">
            <label for="startDate">Start Date:</label>
            <input type="date" id="startDate">
            
            <label for="endDate">End Date:</label>
            <input type="date" id="endDate">
            
            <button onclick="applyFilter()">Apply Filter</button>
            <button class="reset" onclick="resetFilter()">Reset</button>
        </div>
        
        <div class="stats">
            <div class="stat-card">
                <div class="stat-label">Total Active Months Played</div>
                <div class="stat-value" id="totalActiveMonths">-</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Average (Active Months)</div>
                <div class="stat-value" id="avgRunsActive">-</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Average (All Months)</div>
                <div class="stat-value" id="avgRunsAll">-</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Best Month</div>
                <div class="stat-value" id="bestMonth">-</div>
            </div>
        </div>
        
        <div id="chartContainer">
            <canvas id="runsChart"></canvas>
        </div>
        <div class="chart-hint">
            💡 Tip: Scroll to zoom, click and drag to pan the chart
        </div>
    </div>
    
    <script>
        let chart = null;
        let allData = [];
        
        async function loadData() {
            try {
                const response = await fetch('/runs_by_month');
                const data = await response.json();
                
                if (data.length === 0) {
                    document.getElementById('chartContainer').innerHTML = '<p style="text-align: center; color: #999;">No data available</p>';
                    return;
                }
                
                allData = data;
                
                // Set default date range
                if (data.length > 0) {
                    const firstMonth = data[0].month;
                    const lastMonth = data[data.length - 1].month;
                    
                    document.getElementById('startDate').value = firstMonth + '-01';
                    document.getElementById('endDate').value = lastMonth + '-01';
                }
                
                renderChart(data);
            } catch (error) {
                console.error('Error loading chart data:', error);
                document.getElementById('chartContainer').innerHTML = '<p style="text-align: center; color: red;">Error loading data</p>';
            }
        }
        
        function filterData(data, startDate, endDate) {
            if (!startDate && !endDate) {
                return data;
            }
            
            return data.filter(item => {
                const itemDate = item.month;
                if (startDate && itemDate < startDate) return false;
                if (endDate && itemDate > endDate) return false;
                return true;
            });
        }
        
        function applyFilter() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            
            // Convert dates to YYYY-MM format for comparison
            const startMonth = startDate ? startDate.substring(0, 7) : null;
            const endMonth = endDate ? endDate.substring(0, 7) : null;
            
            const filteredData = filterData(allData, startMonth, endMonth);
            renderChart(filteredData);
        }
        
        function resetFilter() {
            if (allData.length > 0) {
                const firstMonth = allData[0].month;
                const lastMonth = allData[allData.length - 1].month;
                
                document.getElementById('startDate').value = firstMonth + '-01';
                document.getElementById('endDate').value = lastMonth + '-01';
            }
            
            renderChart(allData);
        }
        
        function renderChart(data) {
            if (data.length === 0) {
                document.getElementById('chartContainer').innerHTML = '<p style="text-align: center; color: #999;">No data in selected range</p>';
                return;
            }
            
            // Fill in missing months with 0 runs
            const filledData = fillMissingMonths(data);
            
            // Prepare chart data
            const labels = filledData.map(item => {
                const [year, month] = item.month.split('-');
                const date = new Date(year, month - 1);
                return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
            });
            const counts = filledData.map(item => item.count);
            
            // Calculate stats
            const monthsWithRuns = filledData.filter(item => item.count > 0);
            const totalActiveMonths = monthsWithRuns.length;
            const totalAllMonths = filledData.length;
            const totalRuns = counts.reduce((a, b) => a + b, 0);
            const avgRunsActive = totalActiveMonths > 0 ? Math.round(totalRuns / totalActiveMonths) : 0;
            const avgRunsAll = totalAllMonths > 0 ? (totalRuns / totalAllMonths).toFixed(1) : 0;
            const maxRuns = Math.max(...counts);
            const maxMonthIndex = counts.indexOf(maxRuns);
            const bestMonth = labels[maxMonthIndex];
            
            document.getElementById('totalActiveMonths').textContent = totalActiveMonths;
            document.getElementById('avgRunsActive').textContent = avgRunsActive;
            document.getElementById('avgRunsAll').textContent = avgRunsAll;
            document.getElementById('bestMonth').textContent = `${bestMonth} (${maxRuns})`;
            
            // Destroy existing chart
            if (chart) {
                chart.destroy();
            }
            
            // Create chart
            const ctx = document.getElementById('runsChart').getContext('2d');
            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Runs per Month',
                        data: counts,
                        borderColor: '#667eea',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointBackgroundColor: '#667eea',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        },
                        zoom: {
                            zoom: {
                                wheel: {
                                    enabled: true,
                                },
                                pinch: {
                                    enabled: true
                                },
                                mode: 'x',
                            },
                            pan: {
                                enabled: true,
                                mode: 'x',
                                modifierKey: null,
                                onPanStart: function({chart}) {
                                    console.log('Pan started');
                                    return true;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            },
                            title: {
                                display: true,
                                text: 'Number of Runs'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Month'
                            }
                        }
                    }
                }
            });
        }
        
        function fillMissingMonths(data) {
            if (data.length === 0) return data;
            
            const result = [];
            const firstMonth = data[0].month;
            const lastMonth = data[data.length - 1].month;
            
            // Convert to date objects
            let [startYear, startMonth] = firstMonth.split('-').map(Number);
            const [endYear, endMonth] = lastMonth.split('-').map(Number);
            
            // Create a map of existing data for quick lookup
            const dataMap = {};
            data.forEach(item => {
                dataMap[item.month] = item.count;
            });
            
            // Iterate through all months from start to end
            while (startYear < endYear || (startYear === endYear && startMonth <= endMonth)) {
                const monthKey = `${startYear}-${String(startMonth).padStart(2, '0')}`;
                
                result.push({
                    month: monthKey,
                    count: dataMap[monthKey] || 0
                });
                
                // Increment month
                startMonth++;
                if (startMonth > 12) {
                    startMonth = 1;
                    startYear++;
                }
            }
            
            return result;
        }
        
        loadData();
    </script>
</body>
</html>